{
	"name": "inc2734/wp-customizer-framework",
	"description": "A library for WordPress Customizer.",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.4.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"squizlabs/php_codesniffer": "^3.13.6",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"yoast/phpunit-polyfills": "^2.0",
		"phpunit/phpunit": "^9.6"
	},
	"authors": [
		{
			"name": "Takashi Kitajima",
			"email": "inc@2inc.org"
		}
	],
	"autoload": {
		"psr-4" : {
			"Inc2734\\WP_Customizer_Framework\\" : "src"
		}
	},
	"scripts": {
		"format": "phpcbf --standard=./.phpcs.xml.dist --report-summary --report-source",
		"lint": "phpcs --standard=./.phpcs.xml.dist"
	},
	"config": {
		"platform": {
			"php": "7.4.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
